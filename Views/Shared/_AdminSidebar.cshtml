@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<aside class="admin-sidebar" aria-label="Admin navigation">
    <a class="admin-sidebar__brand" asp-controller="AdminBorrowedBooks" asp-action="Index">
        <img src="~/images/iborrowLogo.svg" alt="iBorrow logo" />
    </a>
    <nav class="admin-sidebar__nav">
        <a class="admin-sidebar__link" asp-controller="Library" asp-action="Index"><i class="bi bi-layers" aria-hidden="true"></i><span>Books</span></a>
        <a class="admin-sidebar__link @(controller == "AdminBorrowers" ? "is-active" : "")" asp-controller="AdminBorrowers" asp-action="Index" aria-current="@(controller == "AdminBorrowers" ? "page" : null)"><i class="bi bi-person-fill" aria-hidden="true"></i><span>Borrowers Profile</span></a>
        <a class="admin-sidebar__link @(controller == "AdminBorrowedBooks" ? "is-active" : "")" asp-controller="AdminBorrowedBooks" asp-action="Index" aria-current="page"><i class="bi bi-calendar2-check" aria-hidden="true"></i><span>Borrowed Books</span></a>
        <a class="admin-sidebar__link admin-sidebar__logout" asp-controller="AdminLogin" asp-action="Index"><i class="bi bi-box-arrow-left" aria-hidden="true"></i><span>Logout</span></a>
    </nav>
</aside>
