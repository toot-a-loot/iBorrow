@model iBorrow.Models.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title;

    var borrowDate = DateTime.Today;
    var dueDate = borrowDate;
    var businessDaysAdded = 0;
    while (businessDaysAdded < 7)
    {
        dueDate = dueDate.AddDays(1);
        if (dueDate.DayOfWeek != DayOfWeek.Saturday && dueDate.DayOfWeek != DayOfWeek.Sunday)
        {
            businessDaysAdded++;
        }
    }

    var book = Model.Book;
    var coverUrl = string.IsNullOrWhiteSpace(book.CoverImageUrl) ? "~/images/book-placeholder.svg" : book.CoverImageUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/book/details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/book/borrow-modal.css" asp-append-version="true" />
}

<div class="book-page">
    <div class="book-detail-card shadow-sm">
        <div class="book-detail-top">
            <div class="book-cover-wrap">
                <img src="@coverUrl" alt="Book cover of @book.Title" class="book-cover-img" />
            </div>

            <div class="book-info">
                <h1 class="book-title-lg">@book.Title</h1>
                <p class="book-author-lg">@book.Author</p>

                <span class="status-pill @(book.IsAvailable ? "status-pill--available" : "status-pill--unavailable")">
                    <span class="status-pill-dot" aria-hidden="true"></span>
                    @(book.IsAvailable ? "Available" : "Unavailable")
                </span>

                <p class="tags-label">Tags:</p>
                <div class="tag-list">
                    @foreach (var tag in book.Tags)
                    {
                        <span class="tag-pill">@tag</span>
                    }
                </div>

                <p class="book-description">@book.Synopsis</p>
            </div>

            <button class="btn borrow-btn" type="button" data-bs-toggle="modal" data-bs-target="#borrowModal" @(book.IsAvailable ? "" : "disabled")>Borrow</button>
        </div>

        @if (Model.Similar.Count > 0)
        {
            <h2 class="similar-books-heading">Similar Books</h2>

            <div class="similar-books-grid">
                @foreach (var similar in Model.Similar)
                {
                    var similarCover = string.IsNullOrWhiteSpace(similar.CoverImageUrl) ? "~/images/book-placeholder.svg" : similar.CoverImageUrl;
                    <a class="mini-book-card text-decoration-none text-reset" asp-controller="Book" asp-action="Details" asp-route-id="@similar.Id">
                        <div class="mini-book-cover-wrap">
                            <img src="@similarCover" alt="Book cover of @similar.Title" class="mini-book-cover-img" />
                        </div>
                        <div class="mini-book-body">
                            <h3 class="mini-book-title">@similar.Title</h3>
                            <p class="mini-book-author">@similar.Author</p>
                            <span class="mini-status">
                                <span class="mini-status-dot" aria-hidden="true"></span>
                                @(similar.IsAvailable ? "Available" : "Unavailable")
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="borrowModal" tabindex="-1" aria-labelledby="borrowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered borrow-modal-dialog">
        <div class="modal-content borrow-modal-content">
            <div class="borrow-modal-brand">
                <img src="~/images/iborrowLogo.svg" asp-append-version="true" alt="iBorrow logo" class="borrow-modal-logo" />
                <span class="borrow-modal-brand-text">
                    <span class="borrow-modal-brand-name">iBorrow</span>
                    <span class="borrow-modal-brand-sub">Library System</span>
                </span>
            </div>

            <div class="borrow-ticket">
                <div class="borrow-ticket__header" id="borrowModalLabel">Ready for Reservation</div>

                <div class="borrow-ticket__row">
                    <div class="borrow-ticket__line">
                        <span>Book Title:</span>
                        <span class="fw-bold">@book.Title</span>
                    </div>
                    <div class="borrow-ticket__line">
                        <span>Author:</span>
                        <span class="fw-bold">@book.Author</span>
                    </div>
                </div>

                <hr class="borrow-ticket__divider" />

                <div class="borrow-ticket__row">
                    <div class="borrow-ticket__line">
                        <span>Borrow Date:</span>
                        <span class="fw-bold">@borrowDate.ToString("MM/dd/yy")</span>
                    </div>
                    <div class="borrow-ticket__line">
                        <span>Due Date:</span>
                        <span class="fw-bold">@dueDate.ToString("MM/dd/yy")</span>
                    </div>
                </div>

                <div class="borrow-ticket__notice">
                    <div class="borrow-ticket__notice-top">
                        <i class="bi bi-shield-fill-exclamation borrow-ticket__notice-icon" aria-hidden="true"></i>
                        <div>
                            <p class="borrow-ticket__notice-title">Please take care of the book</p>
                            <p class="borrow-ticket__notice-text">Late returns and damaging the book may result in penalties. Thank you for helping us keep our library in great condition.</p>
                        </div>
                    </div>
                    <hr class="borrow-ticket__notice-divider" />
                    <a href="#" class="borrow-ticket__terms">
                        <span><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i> Terms and Conditions</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="borrow-ticket__actions">
                    <button type="button" class="btn borrow-ticket__cancel-btn" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn borrow-ticket__borrow-btn" data-bs-dismiss="modal">
                        <i class="bi bi-bookmark-fill" aria-hidden="true"></i> Borrow Now
                    </button>
                </div>

                <p class="borrow-ticket__footer">For questions or issues. <a href="#">Contact Us</a></p>
            </div>
        </div>
    </div>
</div>
