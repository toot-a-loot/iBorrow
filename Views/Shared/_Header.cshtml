@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<nav class="navbar navbar-expand-md site-header bg-white">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/iborrowLogo.svg" alt="iBorrow logo" class="brand-logo" />
            <span class="d-flex flex-column lh-sm">
                <span class="fw-bold fs-5">iBorrow</span>
                <span class="small text-secondary">Library System</span>
            </span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="siteNav">
            <ul class="navbar-nav header-center-nav gap-md-4 mt-3 mt-md-0">
                <li class="nav-item">
                    <a class="nav-link brand-nav-link @(currentController == "Home" ? "active" : "")" aria-current="@(currentController == "Home" ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link brand-nav-link @(currentController == "Library" ? "active" : "")" aria-current="@(currentController == "Library" ? "page" : null)" asp-area="" asp-controller="Library" asp-action="Index">Library</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link brand-nav-link @(currentController == "Borrowing" ? "active" : "")" aria-current="@(currentController == "Borrowing" ? "page" : null)" asp-area="" asp-controller="Borrowing" asp-action="Index">Borrowing</a>
                </li>
            </ul>

            <div class="header-actions mt-3 mt-md-0">
                <div class="dropdown notification-menu">
                    <button class="notification-btn" type="button" id="notificationMenuToggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-menu__panel" aria-labelledby="notificationMenuToggle">
                        <div class="notification-menu__header">Notifications</div>
                        <ul class="notification-menu__list">
                            @foreach (var item in iBorrow.Services.NotificationsStore.GetPreview())
                            {
                                <li class="notification-menu__item @(item.IsUnread ? "is-unread" : "")">
                                    <span class="notification-menu__item-title">@item.Title</span>
                                    <span class="notification-menu__item-message">@item.Message</span>
                                    <span class="notification-menu__item-time">@item.TimeAgo</span>
                                </li>
                            }
                        </ul>
                        <a class="notification-menu__view-all" asp-area="" asp-controller="Notifications" asp-action="Index">View all notifications</a>
                    </div>
                </div>

                <div class="dropdown account-menu">
                    <button class="account-menu__toggle" type="button" id="accountMenuToggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        <img src="~/images/userIcon.svg" alt="" class="account-menu__icon" aria-hidden="true" />
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end account-menu__list" aria-labelledby="accountMenuToggle">
                        <li>
                            <a class="dropdown-item account-menu__item" asp-area="" asp-controller="Account" asp-action="Index">Account</a>
                        </li>
                        <li>
                            <form asp-area="" asp-controller="Login" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item account-menu__item">Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>
