@{ ViewData["Title"] = "Library"; var categories = (IReadOnlyList<string>)ViewBag.Categories; }

@section Styles {
    <link rel="stylesheet" href="~/css/pages/library/hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/library/search-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/library/results.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/library/pagination.css" asp-append-version="true" />
}

<section class="hero-banner d-flex align-items-end">
    <div class="hero-overlay">
        <h1 class="hero-title">Borrow Books.</h1>
        <p class="hero-subtitle">Discover available books</p>
    </div>
</section>

<div class="search-card shadow-sm">
    <div class="d-flex flex-column flex-md-row gap-3 align-items-stretch align-items-md-center">
        <div class="input-group search-input-group rounded-3 border overflow-hidden flex-grow-1">
            <span class="input-group-text bg-white border-0 text-primary-brand">
                <i class="bi bi-search" aria-hidden="true"></i>
            </span>
            <input id="librarySearch" type="text" class="form-control border-0 ps-0" placeholder="Search by title, author, or keyword" aria-label="Search by title, author, or keyword" />
            <button class="btn btn-brand search-btn border-0" type="button">Search</button>
        </div>

        <button class="btn advanced-filters-btn d-inline-flex align-items-center justify-content-center gap-2 flex-shrink-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded="false" aria-controls="advancedFilters">
            <i class="bi bi-sliders" aria-hidden="true"></i>
            Advanced Filters
        </button>
    </div>

    <div class="collapse" id="advancedFilters">
        <hr class="search-divider" />

        <div class="row g-3">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filter-label" for="categoryFilter">Category</label>
                <select id="categoryFilter" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filter-label" for="availabilityFilter">Availability</label>
                <select id="availabilityFilter" class="form-select">
                    <option value="">All</option>
                    <option value="available">Available</option>
                    <option value="unavailable">Unavailable</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filter-label" for="courseFilter">Courses</label>
                <select id="courseFilter" class="form-select">
                    <option value="">All Courses</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label filter-label" for="sortFilter">Sort by</label>
                <select id="sortFilter" class="form-select">
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="title-asc">Title (A-Z)</option>
                    <option value="title-desc">Title (Z-A)</option>
                </select>
            </div>
        </div>
    </div>
</div>

<h2 class="search-results-heading">Search Results</h2>

<div id="libraryGrid" class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-4 book-grid"></div>

<nav aria-label="Search results pages" class="pagination-wrap">
    <ul id="libraryPagination" class="pagination custom-pagination justify-content-center mb-0"></ul>
</nav>

@section Scripts {
    <script src="~/js/library.js" asp-append-version="true"></script>
}
